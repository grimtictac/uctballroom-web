SECRET_KEY=change-me
DATABASE=data/app.db
# DigitalOcean Space (step 2)
SPACES_KEY=
SPACES_SECRET=
SPACES_BUCKET=
SPACES_REGION=
SPACES_PUBLIC_BASE_URL=
# Optional key prefix, e.g. dev or prod, to share one bucket
SPACES_PREFIX=
# Google OAuth (step 7)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAILS=
# Backups (used by deploy/provision.sh and piped to the server's /etc/litestream.env; separate private Space + key)
BACKUP_BUCKET=
BACKUP_ACCESS_KEY_ID=
BACKUP_SECRET_ACCESS_KEY=
